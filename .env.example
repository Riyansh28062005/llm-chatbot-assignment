# Comma-separated key pool (key_1, key_2, ... in order). At least 2.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# Frontend build-time API base (set to your deployed backend URL when deploying)
VITE_API_URL=http://localhost:8000
# Offline demo/tests only: answers without calling a provider
LLM_MOCK=false
